# Port the HTTP API listens on
PORT=3002

# Shared secret used to authenticate calls INTO this service (ClinicOS Web must send it as `x-api-key`)
API_KEY=change_me_long_random_secret

# Shared secret sent as `x-webhook-secret` on every inbound webhook to ClinicOS Web
# MUST match WHATSAPP_WEBHOOK_SECRET in ClinicOS Web
WEBHOOK_SECRET=change_me_long_random_secret

# Base URL of ClinicOS Web (inbound webhook target)
CLINICOS_WEB_URL=http://localhost:3000

# Directory for session auth-state persistence (restart-safe)
DATA_DIR=./data

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Comma-separated browser origins allowed to call this service (the WhatsApp
# dashboard page in ClinicOS Web). Use * to allow any origin.
CORS_ORIGINS=https://clinicoseg.vercel.app
